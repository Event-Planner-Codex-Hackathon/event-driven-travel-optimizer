# EventHopper — copy to .env.local and fill in locally. Never commit real values.
# Fill in the values after "=" (no quotes needed). Restart `npm run dev` after editing.
# Frankfurter (exchange rates) and Open-Meteo (weather) need no key.

# --- Fal.ai: route banner images (POST /api/routes/{routeId}/hero)
FAL_KEY=
# Max banner generations per server process (protects the credit budget)
FAL_MAX_GENERATIONS=25

# --- SerpApi: Google Flights / Google Hotels / Google Events
SERPAPI_API_KEY=
# Max new SerpApi calls for one trip price check, and per server process per rolling hour
SERPAPI_MAX_CALLS_PER_CHECK=12
SERPAPI_MAX_CALLS_PER_HOUR=40

# --- Price source: live | record | replay
#   live   = call SerpApi (needs SERPAPI_API_KEY)
#   record = call SerpApi and save each successful result to PRICE_OBSERVATIONS_DIR
#   replay = no SerpApi calls; serve saved results, labeled as recorded observations
PRICE_MODE=live
PRICE_OBSERVATIONS_DIR=data/observations

# --- Ticketmaster Discovery API: event search (fallback source)
TICKETMASTER_API_KEY=
TICKETMASTER_MAX_CALLS_PER_HOUR=40

# --- Eventbrite private token: import one event from an Eventbrite link
#     (Eventbrite no longer offers keyword search)
EVENTBRITE_TOKEN=
EVENTBRITE_MAX_CALLS_PER_HOUR=40

# --- Geoapify: nearby places (server only)
GEOAPIFY_API_KEY=
GEOAPIFY_MAX_CALLS_PER_HOUR=20
GEOAPIFY_MAX_CALLS_TOTAL=100

# --- OpenAI: natural-language trip interpretation (server only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
# Set true only after authorizing API spend or confirming event API credits.
OPENAI_SPEND_AUTHORIZED=false
OPENAI_MAX_CALLS_PER_HOUR=10
OPENAI_MAX_CALLS_TOTAL=20
