# Copy to .env.local and fill in locally. Never commit real values.

# Fal.ai — server-side only, used by POST /api/routes/{routeId}/hero
FAL_KEY=
# Hard cap on Fal image generations per server process (protects the credit budget)
FAL_MAX_GENERATIONS=25

# SerpApi (Google Flights / Google Hotels) — server-side only. Free plan; leave empty to use estimates only.
SERPAPI_API_KEY=
# Max new provider calls for one trip price check, and per server process per rolling hour
SERPAPI_MAX_CALLS_PER_CHECK=12
SERPAPI_MAX_CALLS_PER_HOUR=40
